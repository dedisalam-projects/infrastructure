    {
      "id": 31,
      "title": "Host RAM Available",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15
          },
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "expr": "node_memory_MemAvailable_bytes",
          "legendFormat": "Available RAM",
          "refId": "A"
        }
      ]
    },
    {
      "id": 32,
      "title": "Host Root Disk Used (%)",
      "type": "gauge",
      "gridPos": {
        "x": 8,
        "y": 37,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "100 - ((node_filesystem_avail_bytes{mountpoint=\"/\"} * 100) / node_filesystem_size_bytes{mountpoint=\"/\"})",
          "legendFormat": "Root Disk Used",
          "refId": "A"
        }
      ]
    },
    {
      "id": 33,
      "title": "Host Disk I/O Throughput",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 37,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          },
          "unit": "Bps"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(node_disk_read_bytes_total[1m]))",
          "legendFormat": "Disk Read",
          "refId": "A"
        },
        {
          "expr": "sum(rate(node_disk_written_bytes_total[1m]))",
          "legendFormat": "Disk Write",
          "refId": "B"
        }
      ]
    },
    {
      "id": 34,
      "title": "Scrape Targets Health Status",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 24,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "color": "red",
                  "text": "DOWN"
                },
                "1": {
                  "color": "green",
                  "text": "UP"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal"
      },
      "targets": [
        {
          "expr": "up",
          "legendFormat": "{{job}} ({{instance}})",
          "refId": "A"
        }
      ]
    }
