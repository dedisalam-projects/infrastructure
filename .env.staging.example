# Staging Environment Configuration Template
# COPY THIS FILE TO .env.staging AND UPDATE VALUES

# Application
NODE_ENV=staging
PORT=3000

# Security (MUST BE CHANGED)
JWT_SECRET=changeme_staging_jwt_secret_key_min_32_chars
SESSION_SECRET=changeme_staging_session_secret_min_32_chars

# MongoDB (MUST MATCH DOCKER COMPOSE)
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=changeme_mongo_password
MONGO_URI=mongodb://admin:changeme_mongo_password@mongodb:27017/admin

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme_redis_password

# RabbitMQ
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=changeme_rabbitmq_password
RABBITMQ_URL=amqp://admin:changeme_rabbitmq_password@rabbitmq:5672

# Gateway Ports
GATEWAY_PORT=4000
API_URL=https://api.staging.dedisalam.my.id

# Discord Alerts
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
