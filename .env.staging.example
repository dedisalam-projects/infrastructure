# =============================================================================
# Dedisalam Infrastructure - Staging Environment Configuration (.env.staging)
# =============================================================================
# Used by CI/CD Automated Test Suites and Staging Deployment Pipelines.
# All ports, networks, volumes, and datastores are strictly isolated from production.
# =============================================================================

# Staging Gateway & Integration Endpoint
GATEWAY_STAGING_PORT=3005
GATEWAY_URL=http://localhost:3005

# MongoDB Staging Configuration
MONGO_STAGING_PORT=27018
MONGO_INITDB_ROOT_USERNAME=root_staging
MONGO_INITDB_ROOT_PASSWORD=staging_mongo_password_secret_123
MONGO_INITDB_DATABASE=user_db_staging

# Redis Staging Configuration
REDIS_STAGING_PORT=6380
REDIS_PASSWORD=staging_redis_password_secret_123

# RabbitMQ Staging Configuration
RABBITMQ_STAGING_PORT=5673
RABBITMQ_STAGING_MGMT_PORT=15673
RABBITMQ_USER=staging_user
RABBITMQ_PASS=staging_rabbitmq_password_secret_123

# Microservice Staging Ports
USER_SERVICE_STAGING_PORT=3021
NOTIFICATION_SERVICE_STAGING_PORT=3022

# Security Credentials for Staging Integration Tests
JWT_SECRET=staging_jwt_super_secret_key_for_testing_12345
BACKEND_TAG=latest
