# =============================================================================
# Dedisalam Infrastructure Environment Variables Example
# =============================================================================

# MongoDB Configuration
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=your_secure_mongo_password

# Redis Configuration
REDIS_PASSWORD=your_secure_redis_password

# RabbitMQ Configuration
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# Grafana Observability Credentials
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=your_secure_grafana_password

# Microservice Ports & Secrets (if running full-stack container overlay)
API_GATEWAY_PORT=3000
USER_SERVICE_PORT=3001
NOTIFICATION_SERVICE_PORT=3002
JWT_SECRET=change_this_to_a_secure_jwt_secret
JWT_REFRESH_SECRET=change_this_to_a_secure_jwt_refresh_secret
